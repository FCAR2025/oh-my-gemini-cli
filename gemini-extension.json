{
  "$schema": "https://raw.githubusercontent.com/google-gemini/gemini-cli/main/packages/cli/schemas/gemini-extension.json",
  "name": "oh-my-gemini-cli",
  "version": "0.9.0-fcar.0",
  "description": "FCAR-maintained Gemini CLI workflow extension with Antigravity proxy support, Gemini capability routing, UltraQA gates, /omg:goal autonomous delivery, and v0.42.0 compatibility.",
  "author": "Joonghyun-Lee-Frieren; FCAR2025 maintainers",
  "license": "MIT",
  "homepage": "https://github.com/FCAR2025/oh-my-gemini-cli",
  "sourceUrl": "https://github.com/FCAR2025/oh-my-gemini-cli",
  "contextFileName": "GEMINI.md",
  "settings": [],
  "mcpServers": {
    "omx-state": {
      "command": "node",
      "args": ["/home/info/.npm-global/lib/node_modules/oh-my-codex/dist/mcp/state-server.js"]
    },
    "omx-memory": {
      "command": "node",
      "args": ["/home/info/.npm-global/lib/node_modules/oh-my-codex/dist/mcp/memory-server.js"]
    },
    "omx-wiki": {
      "command": "node",
      "args": ["/home/info/.npm-global/lib/node_modules/oh-my-codex/dist/mcp/wiki-server.js"]
    },
    "omx-trace": {
      "command": "node",
      "args": ["/home/info/.npm-global/lib/node_modules/oh-my-codex/dist/mcp/trace-server.js"]
    },
    "omx-code-intel": {
      "command": "node",
      "args": ["/home/info/.npm-global/lib/node_modules/oh-my-codex/dist/mcp/code-intel-server.js"]
    },
    "omc-bridge": {
      "command": "node",
      "args": ["/home/info/.claude/plugins/cache/omc/oh-my-claudecode/4.14.0/bridge/mcp-server.cjs"],
      "env": {
        "CLAUDE_PLUGIN_ROOT": "/home/info/.claude/plugins/cache/omc/oh-my-claudecode/4.14.0"
      }
    }
  }
}
